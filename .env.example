# Reference only. ProofTrail reads live credentials from the current process
# environment; it does not load this file. Never put real values in Git.
ANTHROPIC_API_KEY=

# Zero-billed real-call option. Create a key in Google AI Studio, verify the
# key's Plan column says Free, then set both variables in the current shell.
GEMINI_API_KEY=
PROOFTRAIL_GEMINI_FREE_TIER=0

# Hard spend ceiling for the whole project, in USD. Live runs refuse to start
# a call that would push the cumulative ledger in data/replay/cost_ledger.jsonl past it.
PROOFTRAIL_BUDGET_USD=30

# Override the default model for ALL roles (agent, B0, B1, claim extractor).
# The comparison is only fair if every role uses the same model — never set per-role.
# PROOFTRAIL_MODEL=gemini-3.7-flash
